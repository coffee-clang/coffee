package "coffee"
version "0.1.0"
description "A moderm package manager for C"
args "--unamed-opts --strict-hidden"

option  "list"    - "List installed commands" flag off
option  "explain" - "Provide a detailed explanation of a rustc error message" string typestr="error_code" optional
option  "verbose" v "Use verbose output (-vv very verbose/build.rs output)" flag off
option  "quiet"   q "Do not print cargo log messages" flag off
option  "color"   - "Coloring [possible values: auto, always, never]" string typestr="color" optional
option  "locked"  - "Assert that `Cargo.lock` will remain unchanged" flag off
option  "offline" - "Run without accessing the network" flag off
option  "frozen"  - "Equivalent to specifying both --locked and --offline" flag off
option  "config"  - "<KEY=VALUE|PATH>  Override a configuration value" string typestr="config" optional
option  "unstable-flags" Z "Unstable (nightly-only) flags to Cargo, see 'cargo -Z help' for details" string typestr="unstable_flag" optional
# AI! update the list of option with all possible options of all cargo subcommands

# The last two options are actually used to have a suitable ENUM that makes it easier to validate
# the values given for the toolchain and command
option  "toolchain"  - "Toolchain used" string values="+stable","+clang-stable","+gcc-stable" enum optional hidden
option  "command" - "command" string optional hidden
