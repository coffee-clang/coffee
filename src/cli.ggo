package "coffee"
version "0.1.0"
description "A moderm package manager for C"
args "--unamed-opts --strict-hidden"

option  "verbose" v "Use verbose output (-vv very verbose/build.rs output)" flag off
option  "quiet" q "Do not print cargo log messages" flag off
option  "color" - "Coloring [possible values: auto, always, never]" string typestr="color" optional
option  "message-format" - "Error format [possible values: human, json, short]" string typestr="message_format" optional
option  "manifest-path" - "Path to Cargo.toml" string typestr="manifest_path" optional
option  "target" - "Build for the target triple" string typestr="target" optional
option  "debug" - "Build with debug symbols" flag off
option  "release" - "Build in release mode" flag off
option  "jobs" j "Number of parallel jobs, defaults to # of CPUs" int optional
option  "bin" - "Build only the specified binary" string typestr="bin_name" optional
option  "example" - "Build only the specified example" string typestr="example_name" optional
option  "features" - "Space-separated list of features to activate" string typestr="features" optional
option  "all-features" - "Activate all available features" flag off
option  "no-default-features" - "Do not activate the `default` feature" flag off
option  "profile" - "Build with given profile" string typestr="profile" optional
option  "target-dir" - "Directory for all generated artifacts" string typestr="target_dir" optional
option  "unit-graph" - "Output build graph in JSON" flag off
option  "ignore-rust-version" - "Ignore `rust-version` specification in packages" flag off
option  "timings" - "Output build timing information" string typestr="timings" optional
option  "future-incompat-report" - "Outputs a future incompatibility report" flag off
option  "workspace" - "Build all packages in the workspace" flag off
option  "exclude" - "Exclude packages from the build" string typestr="exclude" optional
option  "include" - "Include packages in the build" string typestr="include" optional
option  "lib" - "Build only this package's library" flag off
option  "package" p "Package to build" string typestr="pkgid" optional
option  "locked" - "Require Cargo.lock is up to date" flag off
option  "offline" - "Run without accessing the network" flag off
option  "frozen" - "Equivalent to both --locked and --offline" flag off
option  "config" - "Override a configuration value" string typestr="config" optional
option  "unstable-flags" Z "Unstable (nightly-only) flags" string typestr="unstable_flag" optional
option  "dev" - "Add as a development dependency" flag off
option  "build" - "Add as a build dependency" flag off
option  "optional" - "Mark dependency as optional" flag off
option  "no-optional" - "Mark dependency as required" flag off
option  "rename" - "Rename the dependency" string typestr="name" optional
option  "pkg-version" V "Version constraint" string typestr="version" optional
option  "path" - "Filesystem path to local dependency" string typestr="path" optional
option  "git" - "Git repository location" string typestr="url" optional
option  "branch" - "Git branch to download" string typestr="branch" optional
option  "tag" - "Git tag to download" string typestr="tag" optional
option  "rev" - "Git commit reference to download" string typestr="rev" optional
option  "registry" - "Package registry for this dependency" string typestr="registry" optional
option  "dry-run" - "Don't actually write the manifest" flag off
option  "out-dir" - "Output directory for artifacts" string typestr="path" optional
option  "build-plan" - "Output the build plan in JSON" flag off
option  "keep-going" - "Continue building as much as possible" flag off
option  "bins" - "Build all binary targets" flag off
option  "examples" - "Build all example targets" flag off
option  "tests" - "Build all test targets" flag off
option  "benches" - "Build all bench targets" flag off
option  "all-targets" - "Build all targets" flag off
option  "no-run" - "Don't run the generated binaries" flag off
option  "no-fail-fast" - "Run all tests regardless of failure" flag off
option "fix" - "Fix warnings automatically" flag off

# The last two options are actually used to have a suitable ENUM that makes it easier to validate
# the values given for the toolchain and command
option  "toolchain"  - "Toolchain used" string values="+stable","+clang-stable","+gcc-stable" enum optional hidden
option  "command" - "command" string optional hidden
