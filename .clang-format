# coffee coding style - canonical formatting configuration
#
# This file is the ground truth for code formatting. All settings are
# documented with the AGENTS.md rule they implement.
#
# We deviate from curl conventions in:
#   - tabs over spaces (AGENTS.md: "We use tabs for indentation")
#   - tab width 4 (curl uses 2-space indent)
#   - continuation indent 4
#   - column limit 120 (curl uses 79)
#
#Language: Cpp
#Standard: c23

# --- Indentation ---
# AGENTS.md: "We use tabs for indentation, tab width is 4,
# continuing indentation is 4, column limit is 120."
UseTab: ForIndentation          # tabs, never spaces
IndentWidth: 4                  # one tab level
TabWidth: 4                     # tab display width
ContinuationIndentWidth: 4      # continuation lines: one tab
ColumnLimit: 120                # hard limit, no exceptions

# --- Bracing & Control ---
# AGENTS.md: braces on same line for control, new line for functions
# AGENTS.md: "Never omit the braces"
# AGENTS.md: "We never write multiple statements on the same source line"
BreakBeforeBraces: Linux
AllowShortBlocksOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false
InsertBraces: true

# --- Spacing ---
# AGENTS.md: "space between the keyword and the open parenthesis" (if/while/do/for)
# AGENTS.md: "spaces on both sides of operators"
# AGENTS.md: Postfix (), [], ->, ., ++, -- and Unary +, -, !, ~, & have no space
PointerAlignment: Right
SpaceBeforeParens: ControlStatements
SpaceAfterCStyleCast: false
SpaceAfterLogicalNot: false
SpaceBeforeAssignmentOperators: true
SpaceBeforeCaseColon: false
SpaceBeforeSquareBrackets: false
SpaceInEmptyParentheses: false
SpaceInEmptyBlock: false
SpacesBeforeTrailingComments: 1
SpacesInContainerLiterals: false
SpacesInCStyleCastParentheses: false
SpacesInParentheses: false
SpacesInSquareBrackets: false

# --- Alignment ---
# AGENTS.md: align continuation lines on appropriate column
# AGENTS.md: "operators should not start continuation lines"
AlignAfterOpenBracket: Align
AlignConsecutiveAssignments:
  Enabled: true
AlignConsecutiveDeclarations:
  Enabled: true
  AcrossEmptyLines: false
  AcrossComments: true
AlignConsecutiveMacros: true
AlignEscapedNewlines: Left
AlignOperands: true
AlignTrailingComments: true

# --- Wrapping & Bin-packing ---
# AGENTS.md: "operators should not start continuation lines"
BreakBeforeBinaryOperators: None
AllowAllParametersOfDeclarationOnNextLine: false
BinPackArguments: true
BinPackParameters: true
BreakBeforeTernaryOperators: false
BreakStringLiterals: false
AlwaysBreakAfterReturnType: None

# --- Modern C (C23) ---
# AGENTS.md: "use the most recent C standard (C23)"
IntegerLiteralSeparator:
  Binary: 4
  Decimal: 3
  Hex: 2
QualifierAlignment: Left
BreakAfterAttributes: Always

# --- Preprocessor ---
IndentPPDirectives: AfterHash
PPIndentWidth: 1

# --- Includes ---
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  - Regex:           '^"(llvm|llvm-c|clang|clang-c)/'
    Priority:        0
  - Regex:           '^"config\.h"$'
    Priority:        -1
  - Regex:           '^".*"'
    Priority:        1
  - Regex:           '^(<stdint\.h>|<stdbool\.h>|<stddef\.h>)'
    Priority:        2
  - Regex:           '^(<assert\.h>|<errno\.h>|<inttypes\.h>|<limits\.h>|<stdarg\.h>|<stdio\.h>|<stdlib\.h>|<string\.h>|<time\.h>)'
    Priority:        3
  - Regex:           '^<.*'
    Priority:        4

# --- Cleanup ---
MaxEmptyLinesToKeep: 1
KeepEmptyLinesAtTheStartOfBlocks: false
IndentCaseLabels: false
IndentWrappedFunctionNames: false
Cpp11BracedListStyle: false
BitFieldColonSpacing: None

# --- Penalties ---
PenaltyBreakString: 1000
PenaltyBreakComment: 300

# --- Macros ---
ForEachMacros:
  - 'for_each_builtin'
  - 'for_each_string_list_item'
  - 'for_each_ut'
  - 'for_each_wanted_builtin'
  - 'hashmap_for_each_entry'
  - 'hashmap_for_each_entry_from'
  - 'kh_foreach'
  - 'kh_foreach_value'
  - 'list_for_each'
  - 'list_for_each_dir'
  - 'list_for_each_prev'
  - 'list_for_each_prev_safe'
  - 'list_for_each_safe'
  - 'strintmap_for_each_entry'
  - 'strmap_for_each_entry'
  - 'strset_for_each_entry'

IfMacros:
  - 'if_test'
