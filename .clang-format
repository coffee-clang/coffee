# coffee coding style - canonical formatting configuration
#
# This file is the ground truth for code formatting. All settings are
# documented with the AGENTS.md rule they implement.
#
# We deviate from curl conventions in:
#   - tabs over spaces (AGENTS.md: "We use tabs for indentation")
#   - tab width 4 (curl uses 2-space indent)
#   - continuation indent 4
#   - column limit 120 (curl uses 79)
#
---
BasedOnStyle: LLVM
Language: C

# Force clang-format to use the latest language standard features
Standard: Latest


# --- Indentation ---
# AGENTS.md: "We use tabs for indentation, tab width is 4,
# continuing indentation is 4, column limit is 120."
UseTab: ForIndentation          # tabs, never spaces
IndentWidth: 4                  # one tab level
TabWidth: 4                     # tab display width
ContinuationIndentWidth: 4      # continuation lines: one tab
ColumnLimit: 120                # hard limit, no exceptions

# --- Bracing & Control ---
# AGENTS.md: braces on same line for control, new line for functions
# AGENTS.md: "Never omit the braces"
# AGENTS.md: "We never write multiple statements on the same source line"
BreakBeforeBraces: Linux        # break before function braces, not control braces
AllowShortCaseLabelsOnASingleLine: false  # each case on its own line
AllowShortFunctionsOnASingleLine: None    # never collapse function body on one line
AllowShortIfStatementsOnASingleLine: false  # each if body on its own line
AllowShortLoopsOnASingleLine: false       # each loop body on its own line
AllowShortBlocksOnASingleLine: Empty      # only empty {} on same line, e.g. `while (1) {}`
AllowShortLambdasOnASingleLine: All       # collapse short C23 lambdas: `[] {}`
InsertBraces: true                        # auto-insert braces around single-statement bodies

# --- Spacing ---
# AGENTS.md: "space between the keyword and the open parenthesis" (if/while/do/for)
# AGENTS.md: "spaces on both sides of operators"
# AGENTS.md: Postfix (), [], ->, ., ++, -- and Unary +, -, !, ~, & have no space

# Ensure pointers bind to the variable name, not the type (Classic C Style)
# e.g., `char *buffer;` instead of `char* buffer;`
PointerAlignment: Right
SpaceBeforeParens: ControlStatements  # space before ( only for if/while/for/switch, not calls
SpaceAfterCStyleCast: false           # no space after cast: `(int)x` not `(int) x`
SpaceAfterLogicalNot: false           # no space after !: `!x` not `! x`
SpaceBeforeAssignmentOperators: true  # space before = in assignments
SpaceBeforeCaseColon: false           # `case X:` not `case X :`
SpaceBeforeSquareBrackets: false      # `arr[i]` not `arr [i]`
SpaceInEmptyParentheses: false        # `()` not `( )`
SpaceInEmptyBlock: false              # `{}` not `{ }`
SpacesBeforeTrailingComments: 1       # one space before `//`
SpacesInCStyleCastParentheses: false  # `(int)x` not `( int )x`
SpacesInParentheses: false            # no spaces inside parens: `f(x)` not `f( x )`
SpacesInSquareBrackets: false         # `a[i]` not `a[ i ]`

# --- Alignment ---
# AGENTS.md: align continuation lines on appropriate column
# AGENTS.md: "operators should not start continuation lines"
AlignAfterOpenBracket: Align          # align args to opening bracket, not indent
AlignConsecutiveAssignments:          # align `=` across consecutive lines
  Enabled: true
AlignConsecutiveDeclarations:         # align type or name across consecutive declarations
  Enabled: true
  AcrossEmptyLines: false
  AcrossComments: true
AlignConsecutiveMacros: true          # align `\` in consecutive macro continuation lines
AlignEscapedNewlines: Left            # backslash aligned leftmost column
AlignOperands: true                   # align operands of multi-line expressions
AlignTrailingComments: true           # align trailing `//` comments to same column

# --- Wrapping & Bin-packing ---
# AGENTS.md: "operators should not start continuation lines"
BreakBeforeBinaryOperators: None        # break after binary ops, not before
AllowAllParametersOfDeclarationOnNextLine: false  # allow to fit parameters on same line
BinPackArguments: true                  # pack function args to fit column limit
BinPackParameters: true                 # pack function params to fit column limit
BreakBeforeTernaryOperators: false      # break after ? and :, not before them
BreakStringLiterals: false              # never break string literals
AlwaysBreakAfterReturnType: None        # return type on same line as function name

# --- Modern C (C23) ---
# AGENTS.md: "use the most recent C standard (C23)"
IntegerLiteralSeparator:
  Binary: 4        # 0b_0000_1010 -- every 4 digits
  Decimal: 3       # 1_000_000      -- every 3 digits
  Hex: 4           # 0xDEAD_BEEF   -- every 4 digits
QualifierAlignment: Left                # `const int` not `int const`
BreakAfterAttributes: Always            # line break after `[[nodiscard]]`
BreakBeforeConceptDeclarations: Always  # line break before C23 concept declarations


# --- Preprocessor ---
IndentPPDirectives: AfterHash   # indent after #: `#  define X` for nested preprocessor
PPIndentWidth: 1                # one level of indent per nesting

# --- Includes ---
# Ordered: project headers (""), C standard headers (<>), system/third-party (<>)
SortIncludes: CaseSensitive     # case-sensitive alphabetical sort of includes
IncludeBlocks: Regroup          # regroup includes per IncludeCategories priorities
IncludeCategories:
  - Regex:           '^"(llvm|llvm-c|clang|clang-c)/'
    Priority:        0
  - Regex:           '^"config\.h"$'
    Priority:        -1
  - Regex:           '^".*"'
    Priority:        1
  - Regex:           '^(<stdint\.h>|<stdbool\.h>|<stddef\.h>)'
    Priority:        2
  - Regex:           '^(<assert\.h>|<errno\.h>|<inttypes\.h>|<limits\.h>|<stdarg\.h>|<stdio\.h>|<stdlib\.h>|<string\.h>|<time\.h>)'
    Priority:        3
  - Regex:           '^<.*'
    Priority:        4

# --- Cleanup ---
MaxEmptyLinesToKeep: 1                  # at most one blank line
KeepEmptyLinesAtTheStartOfBlocks: false # no leading blank line inside blocks
IndentCaseLabels: false                 # `case X:` at same indent level as `switch`
IndentWrappedFunctionNames: false       # wrapped function name not extra-indented
Cpp11BracedListStyle: false             # C-style list formatting: `int a[] = {1, 2}`
BitFieldColonSpacing: None              # `int x:1` not `int x : 1`

# --- Penalties ---
PenaltyBreakString: 1000   # high penalty: avoid breaking strings at all costs
PenaltyBreakComment: 300   # moderate penalty: prefer breaking here over strings

# --- Macros ---
ForEachMacros:
  - 'for_each_builtin'
  - 'for_each_string_list_item'
  - 'for_each_ut'
  - 'for_each_wanted_builtin'
  - 'hashmap_for_each_entry'
  - 'hashmap_for_each_entry_from'
  - 'kh_foreach'
  - 'kh_foreach_value'
  - 'list_for_each'
  - 'list_for_each_dir'
  - 'list_for_each_prev'
  - 'list_for_each_prev_safe'
  - 'list_for_each_safe'
  - 'strintmap_for_each_entry'
  - 'strmap_for_each_entry'
  - 'strset_for_each_entry'

IfMacros:
  - 'if_test'
