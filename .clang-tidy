Checks: 'clang-analyzer-*,performance-*,readability-*,bugprone-*,misc-*,c11*,-modernize-*,-readability-identifier-length,bugprone-assignment-in-if-condition,readability-sizeof-expression,-misc-no-recursion,-readability-suspicious-call-argument,-bugprone-multi-level-implicit-pointer-conversion,-clang-analyzer-optin.performance.Padding,-clang-analyzer-optin.portability.UnixAPI'
WarningsAsErrors: ''
FormatStyle: file
HeaderFilterRegex: 'src/([^./][^/]*/)?[^./]+\.[ch]'
CheckOptions:
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-magic-numbers.Enabled
    value: true
  - key: readability-braces-around-statements.Enabled
    value: true
  - key: readability-identifier-length.Enabled
    value: true
  - key: readability-sizeof-expression.WarnOnToIntegerCast
    value: true
