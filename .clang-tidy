
---
# Aggressive Security & Memory Safety Configuration for Pure C23
Checks: '
  -*,

  # 1. Core Bug Prevention (Memory tracking, overflows, logical traps)
  bugprone-*,

  # 2. SEI CERT C Security Coding Standard Compliance
  cert-*,

  # 3. Clang Static Analyzer (Deep path analysis for leaks, double-frees, null-derefs)
  clang-analyzer-*,

  # 4. Miscellaneous & Portability Risks
  misc-*,
  -misc-include-cleaner,

  # 5. Selected Performance and Readability Checks that catch security side-effects
  performance-*,
  readability-*,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-function-cognitive-complexity,
  -readability-isolate-declaration,
  
  # 6. EXPLICITLY DISABLE C++ SPECIFIC RULESETS (Prevents C23 compiler friction)
  -modernize-*,
  -cppcoreguidelines-*,
  -google-readability-*,
  -fuchsia-*,

  # 7. OPTIONAL: Silence the C11 Annex K (_s) warning loop if you use standard safe limits
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -bugprone-unsafe-functions
'

# Treat all activated security and memory warnings as compilation errors
WarningsAsErrors: '
  bugprone-*,
  cert-*,
  clang-analyzer-*
'

# Ensure the analyzer checks your local header files but ignores external system libraries
HeaderFilterRegex: 'src/([^./][^/]*/)?[^./]+\.[ch]'

FormatStyle: file


# Configuration adjustments for specific checkers
CheckOptions:
  # Flag any pointer arithmetic configurations that could drift out of bounds
  - key:             bugprone-string-constructor.WarnOnLargeLength
    value:           'true'

  # Enforce strict parsing controls
  - key:             cert-dcl16-c.NewSuffixes
    value:           'true'

  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-magic-numbers.Enabled
    value: true
  - key: readability-braces-around-statements.Enabled
    value: true
  - key: readability-identifier-length.Enabled
    value: true
  - key: readability-sizeof-expression.WarnOnToIntegerCast
    value: true
  - key: readability-function-cognitive-complexity.Threshold
    value: '50'
